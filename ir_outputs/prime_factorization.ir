=== SOURCE CODE ===
PROGRAM PrimeFactorisation
BEGIN
    VAR n : INT;
    VAR d : INT;

    PRINT "Enter a positive integer:";
    INPUT n;
    PRINT "Prime factors of {n}:";

    // Step 1: Handle divisibility by 2
    WHILE (n % 2) == 0 DO
        PRINT 2;
        n := n / 2;
    ENDWHILE

    // Step 2: Iterate odd numbers starting from 3
    d := 3;
    // Loop while d squared is less than or equal to n
    WHILE (d * d) <= n DO
        // While n is divisible by d, print d and divide n
        WHILE (n % d) == 0 DO
            PRINT d;
            n := n / d;
        ENDWHILE
        // Move to next odd number
        d := d + 2;
    ENDWHILE

    // Step 3: If n is a prime number greater than 2
    IF n > 2 THEN
        PRINT n;
    ENDIF
END
