=== SOURCE CODE ===
PROGRAM FibRecursive
    // Global Function Definition
    FUNCTION fib(n : INT) : INT
    BEGIN
        IF n <= 1 THEN
            RETURN n;
        ELSE
            RETURN fib(n - 1) + fib(n - 2);
        ENDIF
    END

MAIN
BEGIN
    VAR terms : INT;
    VAR i : INT;

    PRINT "How many terms?";
    INPUT terms;

    PRINT "Fibonacci Sequence:";
    FOR i := 0 TO terms DO
        PRINT fib(i);
    ENDFOR
END
