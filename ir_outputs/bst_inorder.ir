=== SOURCE CODE ===
PROGRAM TreeTraversal
    // Tree represented as array. -1 indicates NULL.
    VAR tree : ARRAY[15] OF INT;

    FUNCTION inOrder(index : INT) : VOID
    BEGIN
        VAR left : INT;
        VAR right : INT;

        // Check for "NULL" or out of bounds
        IF index >= 15 OR tree[index] == -1 THEN
            RETURN;
        ENDIF

        left := (2 * index) + 1;
        right := (2 * index) + 2;

        // Traverse Left
        inOrder(left);

        // Visit Node
        PRINT tree[index];

        // Traverse Right
        inOrder(right);
    END

MAIN
BEGIN
    VAR i : INT;

    // Initialize "NULL" values
    FOR i := 0 TO 14 DO
        tree[i] := -1;
    ENDFOR

    // Construct Tree:
    //      10
    //     /  \
    //    5    20
    //   / \
    //  3   7
    tree[0] := 10; // Root
    tree[1] := 5;  // Left of 10
    tree[2] := 20; // Right of 10
    tree[3] := 3;  // Left of 5
    tree[4] := 7;  // Right of 5

    PRINT "In-Order Traversal:";
    inOrder(0); 
    // Output should be: 3, 5, 7, 10, 20
END
