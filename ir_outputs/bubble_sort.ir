=== SOURCE CODE ===
PROGRAM BubbleSort
BEGIN
    VAR arr : ARRAY[5] OF INT;
    VAR i : INT;
    VAR j : INT;
    VAR temp : INT;
    VAR n : INT;

    n := 5;
    
    // Initialize unsorted array manually for demo
    arr[0] := 64;
    arr[1] := 34;
    arr[2] := 25;
    arr[3] := 12;
    arr[4] := 22;

    PRINT "Sorting array...";

    // Outer loop
    FOR i := 0 TO n - 2 DO
        // Inner loop
        FOR j := 0 TO n - i - 2 DO
            // Swap if current element is greater than next
            IF arr[j] > arr[j + 1] THEN
                temp := arr[j];
                arr[j] := arr[j + 1];
                arr[j + 1] := temp;
            ENDIF
        ENDFOR
    ENDFOR

    PRINT "Sorted Array:";
    FOREACH val IN arr DO
        PRINT val;
    ENDFOR
END
