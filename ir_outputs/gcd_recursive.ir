goto                                         L1             
Label                                        L2             
%            a               b               t2             
param        t2                                             
param        b                                              
call         gcd             2               t3             
return       t3                                             
Label                                        L1             
endfunc      gcd                                            
print        "Enter first number:"                                
input                                        num1           
print        "Enter second number:"                                
input                                        num2           
param        num2                                           
param        num1                                           
call         gcd             2               t4             
