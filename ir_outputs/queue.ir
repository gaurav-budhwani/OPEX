=== SOURCE CODE ===
PROGRAM QueueDemo
    STRUCT Queue
        data : ARRAY[5] OF INT;
        head : INT;
        tail : INT;
        count : INT;
        capacity : INT;
    ENDSTRUCT

    VAR q : Queue;

    FUNCTION enqueue(val : INT) : VOID
    BEGIN
        IF q.count == q.capacity THEN
            PRINT "Error: Queue Full";
        ELSE
            q.data[q.tail] := val;
            // Circular increment: (tail + 1) % capacity
            q.tail := (q.tail + 1) % q.capacity;
            q.count := q.count + 1;
        ENDIF
    END

    FUNCTION dequeue() : INT
    BEGIN
        VAR val : INT;
        IF q.count == 0 THEN
            PRINT "Error: Queue Empty";
            RETURN -1;
        ELSE
            val := q.data[q.head];
            // Circular increment
            q.head := (q.head + 1) % q.capacity;
            q.count := q.count - 1;
            RETURN val;
        ENDIF
    END

MAIN
BEGIN
    // Initialize Queue
    q.head := 0;
    q.tail := 0;
    q.count := 0;
    q.capacity := 5;

    PRINT "Enqueueing 1, 2, 3...";
    enqueue(1);
    enqueue(2);
    enqueue(3);

    PRINT "Dequeueing...";
    PRINT dequeue(); // Should be 1
    PRINT dequeue(); // Should be 2

    PRINT "Enqueueing 4, 5, 6 (Wrapping around)...";
    enqueue(4);
    enqueue(5);
    enqueue(6); // This wraps to index 0 internally
    
    PRINT "Current Head Value:";
    PRINT q.data[q.head]; // Should be 3
END
