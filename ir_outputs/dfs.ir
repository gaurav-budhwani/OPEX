=== SOURCE CODE ===
PROGRAM GraphDFS
    // Global Adjacency Matrix (5 nodes)
    // 1 indicates connection, 0 indicates no connection
    VAR adj : ARRAY[5][5] OF INT;
    VAR visited : ARRAY[5] OF BOOL;

    FUNCTION dfs(u : INT) : VOID
    BEGIN
        VAR v : INT;
        
        PRINT "Visiting Node: {u}";
        visited[u] := TRUE;

        // Iterate through all possible neighbors
        FOR v := 0 TO 4 DO
            // If connected and not yet visited
            IF adj[u][v] == 1 AND visited[v] == FALSE THEN
                dfs(v);
            ENDIF
        ENDFOR
    END

MAIN
BEGIN
    VAR i : INT;
    VAR j : INT;

    // Initialize Graph (Example Structure)
    // 0 -- 1 -- 2
    // |    |
    // 3 -- 4
    
    // Clear Matrix
    FOR i := 0 TO 4 DO
        visited[i] := FALSE;
        FOR j := 0 TO 4 DO
            adj[i][j] := 0;
        ENDFOR
    ENDFOR

    // Manual Edge Setup (undirected)
    adj[0][1] := 1; adj[1][0] := 1;
    adj[0][3] := 1; adj[3][0] := 1;
    adj[1][2] := 1; adj[2][1] := 1;
    adj[1][4] := 1; adj[4][1] := 1;
    adj[3][4] := 1; adj[4][3] := 1;

    PRINT "Starting DFS from Node 0:";
    dfs(0);
END
