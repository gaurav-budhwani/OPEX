=== SOURCE CODE ===
PROGRAM FloydWarshall
MAIN
BEGIN
    VAR dist : ARRAY[4][4] OF INT;
    VAR i : INT;
    VAR j : INT;
    VAR k : INT;
    VAR INF : INT;

    INF := 9999;

    // Initialize Graph (Weights)
    // INF means no direct edge
    dist[0][0] := 0;   dist[0][1] := 5;   dist[0][2] := INF; dist[0][3] := 10;
    dist[1][0] := INF; dist[1][1] := 0;   dist[1][2] := 3;   dist[1][3] := INF;
    dist[2][0] := INF; dist[2][1] := INF; dist[2][2] := 0;   dist[2][3] := 1;
    dist[3][0] := INF; dist[3][1] := INF; dist[3][2] := INF; dist[3][3] := 0;

    // Triple Nested Loop
    FOR k := 0 TO 3 DO
        FOR i := 0 TO 3 DO
            FOR j := 0 TO 3 DO
                // If path through k is shorter than current path
                IF dist[i][k] + dist[k][j] < dist[i][j] THEN
                    dist[i][j] := dist[i][k] + dist[k][j];
                ENDIF
            ENDFOR
        ENDFOR
    ENDFOR

    PRINT "Shortest Matrix:";
    FOREACH row IN dist DO
        // Only print first element of row for brevity in demo
        PRINT row[0]; 
    ENDFOR
END
