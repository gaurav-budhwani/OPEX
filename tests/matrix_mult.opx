PROGRAM MatrixMult
BEGIN
    VAR A : ARRAY[3][3] OF INT;
    VAR B : ARRAY[3][3] OF INT;
    VAR C : ARRAY[3][3] OF INT;
    VAR i : INT;
    VAR j : INT;
    VAR k : INT;

    // Initialize Matrix A (Identity)
    FOR i := 0 TO 2 DO
        FOR j := 0 TO 2 DO
            IF i == j THEN 
                A[i][j] := 1; 
            ELSE 
                A[i][j] := 0; 
            ENDIF
            // Fill B with some values
            B[i][j] := i + j;
            // Initialize Result C
            C[i][j] := 0;
        ENDFOR
    ENDFOR

    PRINT "Calculating Product...";

    // C[i][j] = Sum(A[i][k] * B[k][j])
    FOR i := 0 TO 2 DO
        FOR j := 0 TO 2 DO
            FOR k := 0 TO 2 DO
                C[i][j] := C[i][j] + (A[i][k] * B[k][j]);
            ENDFOR
        ENDFOR
    ENDFOR

    PRINT "Result Matrix C (Row 0):";
    PRINT C[0][0]; PRINT C[0][1]; PRINT C[0][2];
END